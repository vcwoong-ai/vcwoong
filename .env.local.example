# Database (Supabase PostgreSQL — 권장)
# Supabase → Project Settings → Database → Connection string
# Project ID: jgmvqtmohoxcriobjjfk (Tokyo)

# DATABASE_URL = Supabase Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.jgmvqtmohoxcriobjjfk:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"

# AWS S3 (optional - uses local /uploads for dev)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET=""

# Storage mode: "local" | "s3"
STORAGE_MODE="local"

# Upload directory (for local mode)
UPLOAD_DIR="./public/uploads"

# AI Providers (OpenRouter / Gemini — 실제 AI 생성에 사용)
# Gemini 키가 있으면 기본 모델이 자동으로 gemini-2.5-flash
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Toss Payments (결제 — 미설정 시 설정 페이지에서 안내)
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_..."
TOSS_SECRET_KEY="test_sk_..."

# 외부 데이터 (선택)
KIPRIS_API_KEY=""
NCBI_API_KEY=""

# 딜소싱 자동 인입 (선택)
SOURCING_WEBHOOK_SECRET=""
SOURCING_WEBHOOK_USER_EMAIL="demo@axiom.kr"
SOURCING_INBOX_DIR="./inbox"
