# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dealsync"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"

# AI Provider — 아래 둘 중 하나만 설정하면 됩니다. 둘 다 비워두면 데모 모드로
# 동작합니다(샘플 보고서 자동 생성). Anthropic 키가 있으면 그쪽이 우선합니다.

# 옵션 1) Anthropic Claude API — 실제 키(sk-ant-...) 입력 시 활성화
ANTHROPIC_API_KEY="sk-ant-..."
# 선택: 사용할 모델명 (미지정 시 기본값 사용)
ANTHROPIC_MODEL=""

# 옵션 2) OpenRouter — 여러 모델(DeepSeek/Gemini/Qwen 등)을 하나의 키로 사용.
# 가성비 위주라면 이쪽을 권장. 키(sk-or-...) 입력 시 활성화.
OPENROUTER_API_KEY="sk-or-..."
# 선택: 사용할 모델 id. 기본값은 deepseek/deepseek-v4-flash
# ($0.09/$0.18 per 1M 토큰, 100만 토큰 컨텍스트 — IR 자료 전체를 한 번에 태우기 좋음).
# 다른 후보: google/gemini-2.5-flash (한국어 안정성 우선 시), qwen/qwen3-235b-a22b (아시아 언어 특화)
OPENROUTER_MODEL=""

# AWS S3 (optional - uses local /uploads for dev)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET=""

# Storage mode: "local" | "s3"
STORAGE_MODE="local"

# Upload directory (for local mode)
UPLOAD_DIR="./public/uploads"
