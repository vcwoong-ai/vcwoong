# Database (Neon PostgreSQL — 권장)
# Neon Dashboard → Connect → Pooled / Direct connection

# DATABASE_URL = Neon pooled connection (호스트에 -pooler 포함)
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# DIRECT_URL = Neon direct connection (마이그레이션용, 호스트에 -pooler 없음)
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"

# Vercel Blob (production) — Vercel 프로젝트에서 Storage > Blob 연결 시
# BLOB_READ_WRITE_TOKEN이 자동 주입되며, 있으면 STORAGE_MODE 없이도 자동 사용됨
BLOB_READ_WRITE_TOKEN=""

# AWS S3 (optional - uses local /uploads for dev)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET=""

# Storage mode: "local" | "s3" | "vercel-blob" (미설정 시 BLOB_READ_WRITE_TOKEN 유무로 자동 판단)
STORAGE_MODE="local"

# Upload directory (for local mode)
UPLOAD_DIR="./public/uploads"

# AI Provider (OpenRouter — 실제 AI 생성에 사용)
# 키가 없으면 데모 모드(샘플 콘텐츠)로 동작한다.
OPENROUTER_API_KEY=""
AI_MODEL="deepseek/deepseek-v4-flash-0731"
# 기본 모델이 실패(레이트리밋·타임아웃·모델 오류·품질 게이트 실패)할 때
# 순서대로 시도할 대체 모델 체인(콤마 구분, 앞에서부터 순서대로). 미설정
# 시 아래 기본값과 동일하게 동작한다.
# 무료 모델(openrouter/free 등)은 투자심사보고서처럼 결과물 품질이 중요한
# 용도의 fallback 기본값으로 쓰지 않는다 — 실제로 무료 fallback이 응답
# 대신 의미 없는 텍스트를 반환해 검증 없이 저장된 사고가 있었다(현재는
# generation-time 품질 게이트가 이를 걸러내지만, 애초에 fallback 자체를
# 유료·고품질 모델로 둬 이런 상황 자체를 줄인다). 기본값은 2)로 넘어가기
# 전까지는 비용이 들지 않는다(1차 모델이 정상 응답하면 폴백 자체가 호출
# 안 됨).
AI_FALLBACK_MODELS="google/gemini-2.5-pro,anthropic/claude-sonnet-4.5"
# 하위호환용 — AI_FALLBACK_MODELS가 설정돼 있으면 이 값은 무시된다.
# AI_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# 단일 AI 호출 타임아웃(ms). 미설정 시 25000 — Hobby 플랜 함수 실행시간
# 상한(60초) 안에서 재시도까지 끝내야 해서 짧게 잡혀 있다. Pro로 돌아가면
# AI_CALL_BUDGET_MS(호출 1회의 총 예산, 미설정 시 40000)와 함께 올리면 된다.
AI_REQUEST_TIMEOUT_MS=""
AI_CALL_BUDGET_MS=""
# 보고서 섹션 생성 1회 실행의 시간 예산(ms, 미설정 시 40000) — Hobby 60초
# 상한보다 짧게 잡혀 있다. 양식 슬라이드 추출 예산(ms, 미설정 시 기본값 사용)
REPORT_GENERATION_BUDGET_MS=""
TEMPLATE_EXTRACTION_BUDGET_MS=""

# NVIDIA NIM (선택 — 다른 모델과 품질 비교용, 프로덕션 생성에는 안 쓰임)
# https://build.nvidia.com 에서 API 키 발급. `npm run compare-models`로
# 현재 프로덕션 모델(OpenRouter)과 나란히 비교해볼 수 있다. 비워두면
# 계정에서 쓸 수 있는 모델 목록만 보여준다 — 골라서 아래에 채우면 됨.
# (윈도우에서도 셸 문법 신경 쓸 필요 없이 이 파일에만 채우면 된다)
#
# 주의: 이 계정은 모델 하나당 키가 따로 발급되는 구조라, 공용 키로
# 다른 모델을 호출하면 404("Function ... Not found for account")가 난다.
# build.nvidia.com에서 각 모델 페이지의 코드 예시에 그 모델 전용 키가
# 나오는데, 그걸 모델 ID로 모아서 NIM_MODEL_KEYS에 JSON으로 채우면
# callNimModel이 모델에 맞는 키를 자동으로 골라 쓴다(모델 목록 조회에는
# 공용 키만 있으면 됨).
NVIDIA_NIM_API_KEY=""
NIM_MODELS=""
NIM_MODEL_KEYS=""
# 예: NIM_MODEL_KEYS={"deepseek-ai/deepseek-v4-pro-0813":"nvapi-...","nvidia/nemotron-3-ultra-550b-a55b":"nvapi-..."}

# compare-models.ts CLI 전용 옵션 (전부 선택, 비워두면 내장 BIO 샘플로 실행)
COMPARE_CONTEXT_FILE=""
COMPARE_SECTION=""
COMPARE_AGENT_SECTOR=""
COMPARE_MAX_CONTENT=""

# 보고서 화면 "다른 모델로 비교" 버튼이 호출할 NIM 모델 목록(콤마 구분).
# 비워두면 기본 3개(gpt-oss-20b/nemotron-3-super-120b-a12b/deepseek-v4-pro-0813)
NIM_COMPARISON_MODELS=""

# Toss Payments (결제 — 미설정 시 설정 페이지에서 안내)
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_..."
TOSS_SECRET_KEY="test_sk_..."
# 웹훅 시크릿. 이 값이 없으면 웹훅이 들어와도 구독 상태를 바꾸지 않는다
# (인증 없는 엔드포인트라, 검증 없이 받아주면 아무나 남의 구독을 해지시킬 수 있음)
TOSS_WEBHOOK_SECRET=""

# 외부 데이터 (선택)
KIPRIS_API_KEY=""
NCBI_API_KEY=""
# 전자공시(DART) — https://opendart.fss.or.kr 무료 발급. 비상장 스타트업은
# 대부분 조회돼도 데이터가 없는 게 정상(비상장은 공시 의무 없음)
DART_API_KEY=""
# 딥다이브 검증(보고서 핵심 주장 외부 대조)
# 네이버 클라우드 플랫폼 → NAVER API HUB에서 Application 등록 후,
# "NAVER 검색"의 뉴스·웹문서 두 개만 추가하면 된다(다른 API는 불필요).
# 인증 정보 화면의 Client ID/Secret을 그대로 넣는다.
#   Client ID     → X-NCP-APIGW-API-KEY-ID
#   Client Secret → X-NCP-APIGW-API-KEY
# 엔드포인트: https://naverapihub.apigw.ntruss.com/search/v1/{news,webkr}
# 월 775,000건(일 25,000건) 무료. 과금 방지를 위해 콘솔의 "한도 및 알림"
# 에서 일/월 한도를 걸어둘 것.
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# 위 엔드포인트가 바뀌었을 때만 지정 (기본값 사용 시 비워둘 것)
NAVER_SEARCH_BASE_URL=""

# 보고서 생성 checkpoint 자동 재개(cron, 선택 — 없으면 브라우저 탭이 열려
# 있을 때만 재개됨). Vercel이 vercel.json의 crons로 호출할 때 자동으로
# Authorization: Bearer <값> 헤더를 실어 보낸다 — 값을 직접 지어내지 말고
# Vercel 대시보드가 안내하는 값을 그대로 쓸 것.
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=""

# 딜소싱 자동 인입 (선택)
SOURCING_WEBHOOK_SECRET=""
SOURCING_WEBHOOK_USER_EMAIL="demo@dealmind.kr"
SOURCING_INBOX_DIR="./inbox"
# IMAP (선택 — imapflow 의존성 포함됨, 실메일함 연동 검증용)
# IMAP_HOST=""
# IMAP_USER=""
# IMAP_PASS=""
# IMAP_MAILBOX="INBOX"
# IMAP_PORT=993
# IMAP_SECURE=true

# 이메일 발송 (비밀번호 재설정 — 미설정 시 링크를 서버 로그에만 남김)
RESEND_API_KEY=""
EMAIL_FROM="DealMind <noreply@yourdomain.com>"
