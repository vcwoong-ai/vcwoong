# Database (Neon PostgreSQL — 권장)
# Neon Dashboard → Connect → Pooled / Direct connection

# DATABASE_URL = Neon pooled connection (호스트에 -pooler 포함)
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# DIRECT_URL = Neon direct connection (마이그레이션용, 호스트에 -pooler 없음)
DIRECT_URL="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-32-char-string"

# Vercel Blob (production) — Vercel 프로젝트에서 Storage > Blob 연결 시
# BLOB_READ_WRITE_TOKEN이 자동 주입되며, 있으면 STORAGE_MODE 없이도 자동 사용됨
BLOB_READ_WRITE_TOKEN=""

# AWS S3 (optional - uses local /uploads for dev)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET=""

# Storage mode: "local" | "s3" | "vercel-blob" (미설정 시 BLOB_READ_WRITE_TOKEN 유무로 자동 판단)
STORAGE_MODE="local"

# Upload directory (for local mode)
UPLOAD_DIR="./public/uploads"

# AI Provider (OpenRouter — 실제 AI 생성에 사용)
# 키가 없으면 데모 모드(샘플 콘텐츠)로 동작한다.
OPENROUTER_API_KEY=""
AI_MODEL="deepseek/deepseek-v4-flash-0731"
# 기본 모델이 실패(레이트리밋·타임아웃·모델 오류)할 때 쓰는 대체 모델
AI_FALLBACK_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# 단일 AI 호출 타임아웃(ms). 미설정 시 150000
AI_REQUEST_TIMEOUT_MS=""

# Toss Payments (결제 — 미설정 시 설정 페이지에서 안내)
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_..."
TOSS_SECRET_KEY="test_sk_..."

# 외부 데이터 (선택)
KIPRIS_API_KEY=""
NCBI_API_KEY=""

# 딜소싱 자동 인입 (선택)
SOURCING_WEBHOOK_SECRET=""
SOURCING_WEBHOOK_USER_EMAIL="demo@axiom.kr"
SOURCING_INBOX_DIR="./inbox"
# IMAP (선택 — imapflow 의존성 포함됨, 실메일함 연동 검증용)
# IMAP_HOST=""
# IMAP_USER=""
# IMAP_PASS=""
# IMAP_MAILBOX="INBOX"
# IMAP_PORT=993
# IMAP_SECURE=true
