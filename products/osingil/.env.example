# ── 필수 ─────────────────────────────────────────────
# 배포된 앱 주소 (끝에 / 없이). 카페24 개발자센터에 아래 두 주소를 등록한다:
#   App URL      = {APP_URL}/api/cafe24/launch
#   Redirect URI = {APP_URL}/api/cafe24/callback
APP_URL=https://osingil.vercel.app

# 카페24 개발자센터 > 앱 > 인증 정보
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=

# Neon 등 PostgreSQL 연결 문자열. 테이블은 첫 요청 때 자동 생성된다.
# 로컬 개발은 DATABASE_URL=pglite:./.data/dev 로 설치 없이 실행 가능
DATABASE_URL=

# 세션 서명용 임의 문자열 (32자 이상). 예: openssl rand -hex 32
SESSION_SECRET=

# Vercel Cron이 토큰 갱신 경로를 호출할 때 쓰는 비밀값 (Vercel이 자동으로 Authorization 헤더에 넣음)
CRON_SECRET=

# ── 선택 ─────────────────────────────────────────────
# off: 결제 없이 모두 무제한 (베타 출시용, 기본값) / cafe24: 카페24 인앱 결제 사용
BILLING_MODE=off
PRO_PRICE_KRW=19900
FREE_MONTHLY_RESPONSES=100
# 카페24 앱스토어 상세 페이지 주소 (랜딩 페이지 "설치하기" 버튼)
APP_STORE_URL=https://store.cafe24.com
# 문의 이메일 (랜딩 페이지 하단)
SUPPORT_EMAIL=
