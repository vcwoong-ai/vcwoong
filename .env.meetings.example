# Server-only. Copy to .env.meetings.local for the worker, never commit real keys.
# Feature stays disabled until isolated DB, private storage and provider checks pass.
MEETING_INTELLIGENCE_ENABLED="0"
MEETING_MONTHLY_MINUTES=""
MEETING_MAX_MINUTES=""
MEETING_OPENAI_API_KEY=""
# Absolute ffprobe executable path. Worker runs outside the HTTP request.
MEETING_FFPROBE_PATH=""
DATABASE_URL=""
# Production upload uses the existing private Blob variables in .env.local.example.
