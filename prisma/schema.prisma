// DealMind (딜마인드) - Investment Review Report Automation Platform
// Prisma schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// Auth models (NextAuth.js)
// ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────────────────────────────
// Core models
// ───────────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               UserRole           @default(ANALYST)
  teamId             String?
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  billingKey         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  accounts           Account[]
  sessions           Session[]
  team               Team?                 @relation(fields: [teamId], references: [id])
  deals              Deal[]
  templates          Template[]
  usageLogs          UsageLog[]
  payments           SubscriptionPayment[]
  funds              Fund[]
  portfolioCompanies PortfolioCompany[]
  inboundDeals       InboundDeal[]

  @@index([teamId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  deals              Deal[]
  templates          Template[]
  funds              Fund[]
  portfolioCompanies PortfolioCompany[]
  inboundDeals       InboundDeal[]
}

model Deal {
  id           String     @id @default(cuid())
  name         String
  companyName  String
  sector       DealSector
  stage        DealStage  @default(SCREENING)
  status       DealStatus @default(ACTIVE)
  description  String?    @db.Text
  investAmount Float?
  investRound  String?
  valuation    Float?
  userId       String
  teamId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user      User              @relation(fields: [userId], references: [id])
  team      Team?             @relation(fields: [teamId], references: [id])
  documents Document[]
  reports   Report[]
  portfolio PortfolioCompany?
  score     DealScore?

  @@index([userId])
  @@index([teamId])
  @@index([status])
}

/// 투자 매력도 점수 (보고서 작성 품질이 아니라 투자 판단 점수).
/// 딜 1건당 최신 점수 하나만 유지 — 재계산 시 덮어쓴다.
model DealScore {
  id            String   @id @default(cuid())
  dealId        String   @unique
  overall       Float
  marketSize    Float
  team          Float
  product       Float
  businessModel Float
  financials    Float
  moat          Float
  /// 차원별 한 줄 근거: { marketSize: "...", team: "...", ... }
  rationale     Json
  modelUsed     String
  computedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Document {
  id         String       @id @default(cuid())
  dealId     String
  name       String
  type       DocumentType
  url        String
  size       Int
  mimeType   String
  parsedText String?      @db.Text
  metadata   Json?
  createdAt  DateTime     @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model Template {
  id           String           @id @default(cuid())
  name         String
  description  String?
  fileType     TemplateFileType
  originalName String
  fileUrl      String
  fileSize     Int
  structure    Json?
  sectionMap   Json?
  status       TemplateStatus   @default(PENDING)
  userId       String
  teamId       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  team    Team?    @relation(fields: [teamId], references: [id])
  reports Report[]

  @@index([userId])
  @@index([teamId])
}

model Report {
  id          String       @id @default(cuid())
  dealId      String
  templateId  String?
  title       String
  agentType   AgentType
  status      ReportStatus @default(PENDING)
  exportUrl   String?
  generatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  deal     Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  template Template?       @relation(fields: [templateId], references: [id])
  sections ReportSection[]

  @@index([dealId])
  @@index([templateId])
  @@index([status])
}

model ReportSection {
  id         String        @id @default(cuid())
  reportId   String
  sectionKey SectionKey
  title      String
  content    String        @db.Text
  order      Int
  status     SectionStatus @default(DRAFT)
  feedback   String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ───────────────────────────────────────────────
// Enumerations
// ───────────────────────────────────────────────

enum UserRole {
  ADMIN
  PARTNER
  ANALYST
}

enum SubscriptionPlan {
  FREE
  SOLO
  SECTOR_PRO
  MULTI
  FULL
  BIO_PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model SubscriptionPayment {
  id         String           @id @default(cuid())
  userId     String
  plan       SubscriptionPlan
  amount     Int
  status     String
  paymentKey String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentKey])
}

enum DealSector {
  BIO
  IT
  GENERAL
  FINTECH
  CONSUMER
  DEEPTECH
  CLIMATE
  MANUFACTURING
  CONTENT
}

enum DealStage {
  SCREENING
  DEEP_DIVE
  IC_PREP
  IC_REVIEW
  CLOSED
  REJECTED
}

enum DealStatus {
  ACTIVE
  ARCHIVED
  ON_HOLD
}

enum DocumentType {
  IR_DECK
  FINANCIAL
  PATENT
  CONTRACT
  RESEARCH
  OTHER
}

enum AgentType {
  GENERAL
  BIO
  IT
  DEEPTECH
  MANUFACTURING
  CONTENT
  FINTECH
}

model UsageLog {
  id           String      @id @default(cuid())
  userId       String
  dealId       String?
  reportId     String?
  agentType    AgentType
  sectionKey   SectionKey?
  model        String
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  totalTokens  Int         @default(0)
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

/// 고정 윈도우 레이트리밋 카운터.
/// 서버리스는 인스턴스마다 메모리가 따로 놀아 in-memory 카운터가 무의미하므로
/// DB를 공유 저장소로 쓴다. key = "<용도>:<식별자>" 형태.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

enum TemplateFileType {
  DOCX
  PPTX
}

enum TemplateStatus {
  PENDING
  ANALYZING
  READY
  ERROR
}

enum ReportStatus {
  PENDING
  GENERATING
  DRAFT
  REVIEW
  FINAL
  EXPORTED
}

enum SectionStatus {
  DRAFT
  REVIEWED
  APPROVED
}

enum SectionKey {
  INVESTMENT_OVERVIEW // 투자개요
  COMPANY_OVERVIEW // 회사개요
  PRODUCT_TECHNOLOGY // 제품/기술
  MARKET_ANALYSIS // 시장분석
  FINANCIAL_STATUS // 재무현황
  VALUATION // 밸류에이션
  RISK_ANALYSIS // 리스크
  INVESTMENT_TERMS // 투자조건
  OPINION_SUMMARY // 의견종합
  APPENDIX // 별첨
}

// ───────────────────────────────────────────────
// 풀사이클: 딜소싱 → 심사 → 사후관리 → LP 리포팅
// ───────────────────────────────────────────────

/// 펀드 — LP 리포팅과 포트폴리오의 기준 단위
model Fund {
  id            String   @id @default(cuid())
  name          String
  vintageYear   Int
  /// 결성 총액 (억원)
  fundSize      Float
  /// 납입 완료액 (억원)
  paidIn        Float    @default(0)
  /// 운용 보수율 (%)
  managementFee Float    @default(2)
  userId        String
  teamId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?              @relation(fields: [teamId], references: [id])
  companies PortfolioCompany[]
  lpReports LpReport[]

  @@index([userId])
  @@index([teamId])
}

/// 투자 집행된 포트폴리오사 (사후관리 대상)
model PortfolioCompany {
  id               String          @id @default(cuid())
  /// 심사 딜에서 승격된 경우 원본 딜
  dealId           String?         @unique
  fundId           String?
  companyName      String
  sector           DealSector
  investedAt       DateTime
  /// 투자금 (억원)
  investAmount     Float
  /// 지분율 (%)
  ownershipPercent Float
  /// 투자 시점 기업가치 (억원)
  entryValuation   Float
  /// 최근 평가 기업가치 (억원)
  currentValuation Float?
  /// 회수 금액 (억원)
  realizedAmount   Float           @default(0)
  /// 회수(EXITED/WRITTEN_OFF) 처리일 — XIRR 현금흐름 날짜 기준.
  /// 없으면 updatedAt으로 근사한다 (정확도 낮음, fund-analytics.ts 참고)
  exitedAt         DateTime?
  status           PortfolioStatus @default(ACTIVE)
  notes            String?         @db.Text
  userId           String
  teamId           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       Team?             @relation(fields: [teamId], references: [id])
  fund       Fund?             @relation(fields: [fundId], references: [id])
  deal       Deal?             @relation(fields: [dealId], references: [id])
  kpis       CompanyKPI[]
  milestones Milestone[]
  updates    PortfolioUpdate[]

  @@index([userId])
  @@index([teamId])
  @@index([fundId])
}

/// 분기별 핵심 지표
model CompanyKPI {
  id        String   @id @default(cuid())
  companyId String
  /// 2025Q1 형식
  period    String
  metric    String
  value     Float
  unit      String
  createdAt DateTime @default(now())

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period, metric])
}

/// 투자 조건·사업 마일스톤
model Milestone {
  id        String          @id @default(cuid())
  companyId String
  title     String
  dueDate   DateTime
  status    MilestoneStatus @default(PLANNED)
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// 분기 모니터링 노트
model PortfolioUpdate {
  id         String   @id @default(cuid())
  companyId  String
  period     String
  summary    String   @db.Text
  highlights String?  @db.Text
  concerns   String?  @db.Text
  createdAt  DateTime @default(now())

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period])
}

/// 생성된 LP 리포트
model LpReport {
  id        String       @id @default(cuid())
  fundId    String
  period    String
  title     String
  content   String       @db.Text
  metrics   Json?
  status    ReportStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
}

/// 딜소싱 인박스 — 심사 전 인바운드 딜
model InboundDeal {
  id             String         @id @default(cuid())
  companyName    String
  sector         DealSector     @default(GENERAL)
  source         DealSourceType @default(OTHER)
  contactName    String?
  contactEmail   String?
  summary        String?        @db.Text
  rawText        String?        @db.Text
  /// AI 스크리닝 점수 0~100
  screeningScore Int?
  screeningNotes String?        @db.Text
  status         InboundStatus  @default(NEW)
  /// 심사 딜로 승격된 경우
  dealId         String?
  userId         String
  teamId         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id])

  @@index([userId])
  @@index([teamId])
  @@index([status])
}

enum PortfolioStatus {
  ACTIVE
  WATCH
  RISK
  EXITED
  WRITTEN_OFF
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  DELAYED
}

enum DealSourceType {
  INBOUND
  REFERRAL
  DEMO_DAY
  ACCELERATOR
  OUTREACH
  PARTNER
  OTHER
}

enum InboundStatus {
  NEW
  REVIEWING
  QUALIFIED
  PROMOTED
  REJECTED
}
