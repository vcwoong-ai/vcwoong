// DealMind (딜마인드) - Investment Review Report Automation Platform
// Prisma schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────
// Auth models (NextAuth.js)
// ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ───────────────────────────────────────────────
// Core models
// ───────────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String?            @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               UserRole           @default(ANALYST)
  teamId             String?
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  billingKey         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  accounts           Account[]
  sessions           Session[]
  team               Team?                 @relation(fields: [teamId], references: [id])
  deals              Deal[]
  templates          Template[]
  usageLogs          UsageLog[]
  payments           SubscriptionPayment[]
  funds              Fund[]
  portfolioCompanies PortfolioCompany[]
  inboundDeals       InboundDeal[]
  maDeals            MADeal[]
  peIcReviews        PEICReview[]
  peIcReviewComments PEICReviewComment[]
  peIcReviewSnapshots PEICReviewSnapshot[]
  peIcAuditEvents     PEICAuditEvent[]

  @@index([teamId])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  deals              Deal[]
  templates          Template[]
  funds              Fund[]
  portfolioCompanies PortfolioCompany[]
  inboundDeals       InboundDeal[]
  maDeals            MADeal[]
}

model Deal {
  id           String     @id @default(cuid())
  name         String
  companyName  String
  sector       DealSector
  stage        DealStage  @default(SCREENING)
  status       DealStatus @default(ACTIVE)
  description  String?    @db.Text
  investAmount Float?
  investRound  String?
  valuation    Float?
  userId       String
  teamId       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user      User              @relation(fields: [userId], references: [id])
  team      Team?             @relation(fields: [teamId], references: [id])
  documents Document[]
  reports   Report[]
  portfolio PortfolioCompany?
  score     DealScore?

  @@index([userId])
  @@index([teamId])
  @@index([status])
}

/// 투자 매력도 점수 (보고서 작성 품질이 아니라 투자 판단 점수).
/// 딜 1건당 최신 점수 하나만 유지 — 재계산 시 덮어쓴다.
model DealScore {
  id            String   @id @default(cuid())
  dealId        String   @unique
  overall       Float
  marketSize    Float
  team          Float
  product       Float
  businessModel Float
  financials    Float
  moat          Float
  /// 차원별 한 줄 근거: { marketSize: "...", team: "...", ... }
  rationale     Json
  modelUsed     String
  /// evidence.ts 근거 추적과 연결한 확신도·커버리지·risk flag·IC 요약
  /// (ScoreEvidenceAssessment, deal-scoring-evidence.ts). 기존 점수 재계산 전
  /// 저장분에는 없을 수 있어 nullable — 없으면 UI가 "평가 안 됨"으로 표시.
  evidenceAssessment Json?
  computedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Document {
  id         String       @id @default(cuid())
  dealId     String
  name       String
  type       DocumentType
  url        String
  size       Int
  mimeType   String
  parsedText String?      @db.Text
  metadata   Json?
  createdAt  DateTime     @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model Template {
  id           String           @id @default(cuid())
  name         String
  description  String?
  fileType     TemplateFileType
  originalName String
  fileUrl      String
  fileSize     Int
  structure    Json?
  sectionMap   Json?
  status       TemplateStatus   @default(PENDING)
  userId       String
  teamId       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  team    Team?    @relation(fields: [teamId], references: [id])
  reports Report[]

  @@index([userId])
  @@index([teamId])
}

model Report {
  id          String       @id @default(cuid())
  dealId      String
  templateId  String?
  title       String
  agentType   AgentType
  status      ReportStatus @default(PENDING)
  exportUrl   String?
  generatedAt DateTime?
  // 지금 생성 중인 섹션 제목(예: "투자개요") — 여러 서버리스 인스턴스가
  // /run(쓰기)과 /status(읽기)를 각각 다른 인스턴스에서 처리할 수 있어
  // in-memory 진행률 저장소로는 서로의 진행 상황을 볼 수 없었다. 완성된
  // 섹션 수는 이미 ReportSection 테이블로 세므로, 여기엔 "현재 섹션명"만
  // 둔다. 생성 중이 아니면 null.
  currentSectionTitle String?
  // 서버 측(cron) 자동 재개 시도 횟수 — 브라우저 폴링(client-only, in-memory
  // MAX_AUTO_RESUMES)과 달리 cron은 매 tick마다 새 invocation(상태 없음)이라
  // "무한 재시도" 방지를 위해 DB에 횟수를 남겨야 한다. 실패가 반복되는
  // 보고서를 영원히 재시도하지 않도록 상한(MAX_AUTO_RESUME_ATTEMPTS)과 함께
  // 쓴다. 새로 생성되거나 "재생성"(mode=restart) 시 0으로 리셋된다.
  autoResumeCount Int @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  deal     Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  template Template?       @relation(fields: [templateId], references: [id])
  sections ReportSection[]
  deepDive ReportDeepDive?
  evidenceCheck ReportEvidenceCheck?
  icQuestions ReportIcQuestions?

  @@index([dealId])
  @@index([templateId])
  @@index([status])
}

/// 보조 리서치(딥다이브 검증) — 보고서 핵심 주장을 웹·뉴스 외부 자료로
/// 교차 검증한 결과. evidence.ts(업로드 문서 내부 대조)와 반대 방향으로,
/// 여기는 외부에서 새 근거를 끌어온다. 보고서 1건당 최신 결과 하나만 유지.
model ReportDeepDive {
  id         String   @id @default(cuid())
  reportId   String   @unique
  /// [{ claim, verdict, rationale, sources: [{title,url,source}] }, ...]
  claims     Json
  modelUsed  String
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

/// 근거 추적(evidence.ts) 중 deterministic 매칭(숫자 색인·키워드 겹침)으로
/// 못 찾은 claim만 골라 AI로 재확인한 결과 캐시. ReportDeepDive와 같은
/// 구조(보고서 1건당 최신 결과 하나) — /evidence GET마다 AI를 다시 부르지
/// 않기 위해 저장해둔다(evidence-ai.ts, /api/reports/[id]/evidence/verify 참고).
model ReportEvidenceCheck {
  id         String   @id @default(cuid())
  reportId   String   @unique
  /// AiClaimVerdict[] — { claimKey, confidence, rationale, documentName?, location?, snippet? }
  verdicts   Json
  modelUsed  String
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

/// IC(투자심의위원회) 질문 — DealScore.evidenceAssessment(Phase 4)에서 결정적으로
/// 도출한 질문 후보를 필요시 AI로 문장만 다듬은 결과. ReportDeepDive/
/// ReportEvidenceCheck와 같은 구조(보고서 1건당 최신 결과 하나) —
/// ic-questions.ts, /api/reports/[id]/ic-questions/generate 참고.
model ReportIcQuestions {
  id         String   @id @default(cuid())
  reportId   String   @unique
  /// IcQuestion[] — { id, category, question, whyItMatters, trigger, priority,
  /// relatedDimension?, relatedClaim?, relatedEvidence?, suggestedAnswerType, source }
  questions  Json
  modelUsed  String
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ReportSection {
  id         String        @id @default(cuid())
  reportId   String
  sectionKey SectionKey
  title      String
  content    String        @db.Text
  order      Int
  status     SectionStatus @default(DRAFT)
  feedback   String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ───────────────────────────────────────────────
// Enumerations
// ───────────────────────────────────────────────

enum UserRole {
  ADMIN
  PARTNER
  ANALYST
}

enum SubscriptionPlan {
  FREE
  SOLO
  SECTOR_PRO
  MULTI
  FULL
  BIO_PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

model SubscriptionPayment {
  id         String           @id @default(cuid())
  userId     String
  plan       SubscriptionPlan
  amount     Int
  status     String
  paymentKey String?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paymentKey])
}

enum DealSector {
  BIO
  IT
  GENERAL
  FINTECH
  CONSUMER
  DEEPTECH
  CLIMATE
  MANUFACTURING
  CONTENT
}

enum DealStage {
  SCREENING
  DEEP_DIVE
  IC_PREP
  IC_REVIEW
  CLOSED
  REJECTED
}

enum DealStatus {
  ACTIVE
  ARCHIVED
  ON_HOLD
}

enum DocumentType {
  IR_DECK
  FINANCIAL
  PATENT
  CONTRACT
  RESEARCH
  OTHER
}

enum AgentType {
  GENERAL
  BIO
  IT
  DEEPTECH
  MANUFACTURING
  CONTENT
  FINTECH
}

model UsageLog {
  id           String      @id @default(cuid())
  userId       String
  dealId       String?
  reportId     String?
  agentType    AgentType
  sectionKey   SectionKey?
  model        String
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  totalTokens  Int         @default(0)
  /// 이 호출을 실제로 처리한 provider(OpenRouter 응답 기준, 확인 안 되면 null — 지어내지 않음)
  provider      String?
  /// 이 호출 1회(모델 체인의 시도 하나)에 걸린 시간(ms)
  durationMs    Int?
  /// 체인 내 시도 위치(0=primary, 1 이상=fallback) — "몇 번째 시도였는가"
  retryCount    Int?
  /// OpenRouter가 응답에 실은 실제 비용(USD) — 가격 정보가 없으면 null(추정하지 않음, 0원이 아님)
  estimatedCost Float?
  /// 호출 시점의 구독 플랜 축(free/paid) — Cost-aware Model Router 진단용
  userTier      String?
  /// 호출 시점의 task tier(cheap/balanced/premium) — 3-tier Cost-Performance Model Router 진단용
  taskTier      String?
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

/// 고정 윈도우 레이트리밋 카운터.
/// 서버리스는 인스턴스마다 메모리가 따로 놀아 in-memory 카운터가 무의미하므로
/// DB를 공유 저장소로 쓴다. key = "<용도>:<식별자>" 형태.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

enum TemplateFileType {
  DOCX
  PPTX
}

enum TemplateStatus {
  PENDING
  ANALYZING
  READY
  ERROR
}

enum ReportStatus {
  PENDING
  GENERATING
  DRAFT
  REVIEW
  FINAL
  EXPORTED
}

enum SectionStatus {
  DRAFT
  REVIEWED
  APPROVED
}

enum SectionKey {
  INVESTMENT_OVERVIEW // 투자개요
  COMPANY_OVERVIEW // 회사개요
  PRODUCT_TECHNOLOGY // 제품/기술
  MARKET_ANALYSIS // 시장분석
  FINANCIAL_STATUS // 재무현황
  VALUATION // 밸류에이션
  RISK_ANALYSIS // 리스크
  INVESTMENT_TERMS // 투자조건
  OPINION_SUMMARY // 의견종합
  APPENDIX // 별첨
}

// ───────────────────────────────────────────────
// 풀사이클: 딜소싱 → 심사 → 사후관리 → LP 리포팅
// ───────────────────────────────────────────────

/// 펀드 — LP 리포팅과 포트폴리오의 기준 단위
model Fund {
  id            String   @id @default(cuid())
  name          String
  vintageYear   Int
  /// 결성 총액 (억원)
  fundSize      Float
  /// 납입 완료액 (억원)
  paidIn        Float    @default(0)
  /// 운용 보수율 (%)
  managementFee Float    @default(2)
  userId        String
  teamId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team?              @relation(fields: [teamId], references: [id])
  companies PortfolioCompany[]
  lpReports LpReport[]

  @@index([userId])
  @@index([teamId])
}

/// 투자 집행된 포트폴리오사 (사후관리 대상)
model PortfolioCompany {
  id               String          @id @default(cuid())
  /// 심사 딜에서 승격된 경우 원본 딜
  dealId           String?         @unique
  fundId           String?
  companyName      String
  sector           DealSector
  investedAt       DateTime
  /// 투자금 (억원)
  investAmount     Float
  /// 지분율 (%)
  ownershipPercent Float
  /// 투자 시점 기업가치 (억원)
  entryValuation   Float
  /// 최근 평가 기업가치 (억원)
  currentValuation Float?
  /// 회수 금액 (억원)
  realizedAmount   Float           @default(0)
  /// 회수(EXITED/WRITTEN_OFF) 처리일 — XIRR 현금흐름 날짜 기준.
  /// 없으면 updatedAt으로 근사한다 (정확도 낮음, fund-analytics.ts 참고)
  exitedAt         DateTime?
  status           PortfolioStatus @default(ACTIVE)
  notes            String?         @db.Text
  userId           String
  teamId           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       Team?             @relation(fields: [teamId], references: [id])
  fund       Fund?             @relation(fields: [fundId], references: [id])
  deal       Deal?             @relation(fields: [dealId], references: [id])
  kpis       CompanyKPI[]
  milestones Milestone[]
  updates    PortfolioUpdate[]

  @@index([userId])
  @@index([teamId])
  @@index([fundId])
}

/// 분기별 핵심 지표
model CompanyKPI {
  id        String   @id @default(cuid())
  companyId String
  /// 2025Q1 형식
  period    String
  metric    String
  value     Float
  unit      String
  createdAt DateTime @default(now())

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period, metric])
}

/// 투자 조건·사업 마일스톤
model Milestone {
  id        String          @id @default(cuid())
  companyId String
  title     String
  dueDate   DateTime
  status    MilestoneStatus @default(PLANNED)
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// 분기 모니터링 노트
model PortfolioUpdate {
  id         String   @id @default(cuid())
  companyId  String
  period     String
  summary    String   @db.Text
  highlights String?  @db.Text
  concerns   String?  @db.Text
  createdAt  DateTime @default(now())

  company PortfolioCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period])
}

/// 생성된 LP 리포트
model LpReport {
  id        String       @id @default(cuid())
  fundId    String
  period    String
  title     String
  content   String       @db.Text
  metrics   Json?
  status    ReportStatus @default(DRAFT)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  fund Fund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
}

/// 딜소싱 인박스 — 심사 전 인바운드 딜
model InboundDeal {
  id             String         @id @default(cuid())
  companyName    String
  sector         DealSector     @default(GENERAL)
  source         DealSourceType @default(OTHER)
  contactName    String?
  contactEmail   String?
  summary        String?        @db.Text
  rawText        String?        @db.Text
  /// AI 스크리닝 점수 0~100
  screeningScore Int?
  screeningNotes String?        @db.Text
  status         InboundStatus  @default(NEW)
  /// 심사 딜로 승격된 경우
  dealId         String?
  userId         String
  teamId         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id])

  @@index([userId])
  @@index([teamId])
  @@index([status])
}

enum PortfolioStatus {
  ACTIVE
  WATCH
  RISK
  EXITED
  WRITTEN_OFF
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  DELAYED
}

enum DealSourceType {
  INBOUND
  REFERRAL
  DEMO_DAY
  ACCELERATOR
  OUTREACH
  PARTNER
  OTHER
}

enum InboundStatus {
  NEW
  REVIEWING
  QUALIFIED
  PROMOTED
  REJECTED
}

// ───────────────────────────────────────────────
// PE 트랙 — Domain Foundation (PR-A)
//
// VC의 Deal/Report/SectionKey와 완전히 분리된 별도 모델이다 — VC 기존
// 모델·enum은 이 섹션에서 단 한 건도 수정하지 않는다(PE Track Phase 2
// Blueprint §5 참고). LBO 계산 로직(src/lib/lbo-model.ts, PR #90)은
// Prisma에 의존하지 않는 순수 함수라 이 스키마와 무관하며, 여기서도
// 연결하지 않는다 — LboModel 테이블은 실제 사용처(LBO integration, PR-E)가
// 생기기 전까지 만들지 않는다.
// ───────────────────────────────────────────────

model MADeal {
  id          String       @id @default(cuid())
  /// 딜 명칭 — companyName과 별개로 유지한다(향후 딜 명과 대상회사명이
  /// 서로 다른 개념이 될 수 있음, 예: 동일 대상회사에 대한 재딜)
  name        String
  companyName String
  dealType    MaDealType
  status      MaDealStatus @default(ACTIVE)
  userId      String
  teamId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User         @relation(fields: [userId], references: [id])
  team      Team?        @relation(fields: [teamId], references: [id])
  documents MADocument[]
  reports   MAReport[]
  financialPeriods MAFinancialPeriod[]
  ddCase    PEDDCase?
  icReviews        PEICReview[]
  icReviewComments PEICReviewComment[]
  icReviewSnapshots PEICReviewSnapshot[]
  icAuditEvents     PEICAuditEvent[]

  @@index([userId])
  @@index([teamId])
  @@index([status])
}

model MADocument {
  id         String         @id @default(cuid())
  maDealId   String
  name       String
  type       MaDocumentType
  url        String
  size       Int
  mimeType   String
  parsedText String?        @db.Text
  metadata   Json?
  createdAt  DateTime       @default(now())

  maDeal     MADeal       @relation(fields: [maDealId], references: [id], onDelete: Cascade)
  /// 이 문서를 근거로 인용하는 PE DD Evidence(PR #105) — 문서가 삭제돼도
  /// evidence 자체는 감사 기록으로 남아야 하므로 documentId만 SetNull된다
  /// (PEEvidence 모델 정의 참고).
  peEvidence PEEvidence[]
  /// 이 문서로 해결을 시도하는 evidence request(PR #109) — 동일하게 SetNull.
  peEvidenceRequests PEEvidenceRequest[]

  @@index([maDealId])
}

model MAReport {
  id        String         @id @default(cuid())
  maDealId  String
  title     String
  status    MaReportStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  maDeal   MADeal            @relation(fields: [maDealId], references: [id], onDelete: Cascade)
  sections MAReportSection[]

  @@index([maDealId])
  @@index([status])
}

model MAReportSection {
  id         String        @id @default(cuid())
  maReportId String
  sectionKey MaSectionKey
  title      String
  content    String        @db.Text
  order      Int
  status     SectionStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  maReport MAReport @relation(fields: [maReportId], references: [id], onDelete: Cascade)

  @@index([maReportId])
}

enum MaDealType {
  BUYOUT
  GROWTH_EQUITY
  CARVE_OUT
  MBO
  SECONDARY
  MINORITY
}

enum MaDealStatus {
  ACTIVE
  ARCHIVED
}

enum MaDocumentType {
  MANAGEMENT_ACCOUNTS
  DD_MATERIAL
  FINANCIAL_MODEL
  CONTRACT
  OTHER
}

enum MaReportStatus {
  PENDING
  DRAFT
}

enum MaSectionKey {
  DEAL_OVERVIEW
  FINANCIAL_NORMALIZATION
  QOE_ANALYSIS
  LBO_ANALYSIS
  DD_SUMMARY
  RETURNS_ANALYSIS
  RISK_FACTORS
  RECOMMENDATION
}

// ───────────────────────────────────────────────
// PE 트랙 — Financial Normalization Foundation (PR-B)
//
// 원천 재무 데이터(MAFinancialLineItem, source/sourceLocation로 출처 보존)
// → 정규화 엔진(src/lib/pe/financial-normalization.ts, 순수 함수,
// LLM·DB 미사용) → EBITDA/Net Debt/FCF 등 파생 지표. QoE 분류(일회성/
// 런레이트 등)·DART 연동·LBO 연결은 이후 PR(PR-C/D/E) 범위 — 여기서는
// MAFinancialAdjustment가 그 확장을 받을 수 있는 최소 구조만 둔다.
// lineItem/metric은 enum으로 고정하지 않는다(CompanyKPI.metric과 동일한
// 이유 — financial-types.ts의 CANONICAL_LINE_ITEMS가 API 레벨 검증을 맡는다).
// ───────────────────────────────────────────────

model MAFinancialPeriod {
  id         String                @id @default(cuid())
  maDealId   String
  fiscalYear Int
  periodType MaFinancialPeriodType
  startDate  DateTime
  endDate    DateTime
  /// ISO 통화 코드(예: KRW, USD) — 이 기간에 속한 모든 line item·adjustment는
  /// 반드시 같은 통화여야 한다(정규화 엔진이 다르면 currency_mismatch 반환)
  currency   String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  maDeal      MADeal                   @relation(fields: [maDealId], references: [id], onDelete: Cascade)
  lineItems   MAFinancialLineItem[]
  adjustments MAFinancialAdjustment[]
  /// 이 기간을 참조하는 PE DD Finding(PR #105) — 기간이 삭제돼도 finding
  /// 자체는 남아야 하므로 financialPeriodId만 SetNull된다.
  ddFindings  PEDDFinding[]

  @@unique([maDealId, fiscalYear, periodType])
  @@index([maDealId])
  @@index([fiscalYear])
}

model MAFinancialLineItem {
  id                String                   @id @default(cuid())
  financialPeriodId String
  statementType     MaFinancialStatementType
  /// CANONICAL_LINE_ITEMS(financial-types.ts) 값만 API에서 허용 — DB 컬럼은
  /// 향후 확장을 막지 않기 위해 String으로 둔다(CompanyKPI.metric과 동일 패턴)
  lineItem          String
  /// 원본 통화 최소 단위 금액(예: KRW는 "원") — 억원 환산 없음(financial-types.ts 참고)
  value             Float
  currency          String
  source            MaFinancialSourceType
  sourceName        String?
  sourceLocation    String?
  /// 원본 라벨을 표준 계정명으로 매핑 완료했는지 여부(향후 원천 자동 매핑 단계용)
  isNormalized      Boolean                  @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  financialPeriod MAFinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)

  @@index([financialPeriodId])
  @@index([financialPeriodId, lineItem])
}

/// 원천값 → 조정값 → 정규화값을 추적한다(Adjusted EBITDA 등을 조정 없이
/// 최종값만 저장하지 않기 위함). QoE 카테고리 분류(일회성/런레이트/시너지
/// 등)는 PR-D 범위 — metric·reason만으로 최소 구조를 유지한다.
model MAFinancialAdjustment {
  id                String                @id @default(cuid())
  financialPeriodId String
  /// CANONICAL_LINE_ITEMS 값 중 하나(현재는 EBITDA 조정만 정규화 엔진이 반영)
  metric            String
  reportedValue     Float
  adjustmentValue   Float
  /// = reportedValue + adjustmentValue(정규화 엔진의 결정적 계산, 생성 시점에 저장)
  normalizedValue   Float
  reason            String
  source            MaFinancialSourceType
  sourceName        String?
  sourceLocation    String?
  /// PR-D QoEAdjustmentStatus(qoe-types.ts)와 정확히 일치. APPROVED만 정규화
  /// 엔진(deriveAdjustedEbitda)에 전달된다(qoe.ts의 toApprovedAdjustmentInputs).
  /// 기존 row는 이 컬럼이 생기기 전부터 이미 무조건 계산에 포함되고 있었으므로
  /// (PR-B 엔진은 상태 개념 없이 전달받은 조정을 전부 합산) @default(APPROVED)로
  /// 초기화한다 — 계산 결과를 조용히 바꾸지 않는 쪽을 "보수적"으로 판단했다
  /// (PR-D.1 최종 보고서 §4 참고).
  status            MaAdjustmentStatus    @default(APPROVED)
  /// PR-D QoEAdjustmentType(qoe-types.ts)와 정확히 일치. 기존 row는 분류
  /// 정보가 전혀 없었으므로 실제로 모르는 값을 지어내지 않고 OTHER로 초기화한다.
  adjustmentType    MaAdjustmentType      @default(OTHER)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  financialPeriod MAFinancialPeriod @relation(fields: [financialPeriodId], references: [id], onDelete: Cascade)

  @@index([financialPeriodId])
}

enum MaFinancialPeriodType {
  ANNUAL
  QUARTERLY
  TTM
}

enum MaFinancialStatementType {
  INCOME_STATEMENT
  BALANCE_SHEET
  CASH_FLOW
}

enum MaFinancialSourceType {
  UPLOADED_DOCUMENT
  EXCEL
  DART
  MANUAL
}

/// PR-D qoe-types.ts의 QOE_ADJUSTMENT_STATUSES와 값이 정확히 일치해야 한다.
enum MaAdjustmentStatus {
  DRAFT
  PROPOSED
  APPROVED
  REJECTED
}

/// PR-D qoe-types.ts의 QOE_ADJUSTMENT_TYPES와 값이 정확히 일치해야 한다.
enum MaAdjustmentType {
  ONE_OFF_EXPENSE
  OWNER_COMPENSATION_NORMALIZATION
  RELATED_PARTY_NORMALIZATION
  RESTRUCTURING
  ONE_TIME_PROFESSIONAL_FEE
  NON_RECURRING_OPERATING_COST
  ONE_OFF_INCOME
  NON_RECURRING_REVENUE
  UNSUSTAINABLE_MARGIN
  OTHER
}

// ───────────────────────────────────────────────
// PE 트랙 — DD & Evidence Persistence Foundation (PR #105)
//
// PEDDCase/PEDDFinding/PEEvidence는 사실과 워크플로 상태(status/severity/
// 근거 참조)만 저장한다. "이 finding이 실제로 타당한가", "readiness가
// 무엇인가"는 여전히 순수 결정론적 엔진(dd-lineage.ts의 validatePEDDCase(),
// pe-decision-readiness.ts의 buildPEDecisionReadiness())이 판단한다 — 이
// 스키마 자체는 그 판단을 내리지 않는다. AI는 이 테이블에 직접
// CONFIRMED/승인/readiness를 쓸 수 없다(모든 쓰기는 pe-dd-repository.ts의
// requiresEvidenceForStatus() 검증을 통과해야 함).
//
// PEDDCategory/PEDDSeverity/PEDDFindingStatus 값은 src/lib/pe/dd-types.ts의
// PE_DD_CATEGORIES/PE_DD_SEVERITIES/PE_DD_FINDING_STATUSES와 정확히
// 일치해야 한다(MaAdjustmentStatus가 QOE_ADJUSTMENT_STATUSES와 일치해야
// 하는 것과 같은 원칙).
//
// Evidence Lineage(PR-F, evidence-lineage-types.ts)의 PEEvidenceSource/
// PEEvidenceItem은 이 PR에서 DB 테이블로 만들지 않는다(그 타입 자체가
// "결정론적 순수 데이터, DB에 저장하지 않는다"고 명시함) — 대신 PEEvidence
// 한 행이 Source+Evidence 두 개념을 함께 담고, pe-dd-persistence-adapter.ts가
// 조회 시점에 createEvidenceSource()/createEvidenceItem()(evidence-lineage.ts,
// 수정 없음)을 그대로 호출해 순수 lineage 노드로 펼친다.
//
// PEClaim은 이 PR에서 영속화하지 않는다 — DD finding의 evidence 요구사항은
// evidenceIds만으로 충분히 만족되고(claimIds는 항상 빈 배열), claim 수준
// 구조화가 실제로 필요해지면 이 스키마를 확장 없이(추가적으로만) 붙일 수
// 있다.
//
// Commercial DD(고객/매출 데이터)는 이 PR에서 영속화하지 않는다 — 아직
// 실제 UI/AI 파이프라인이 없어 대규모 스키마를 미리 만들 근거가 없다
// (후속 PR에서 필요해지면 별도로 설계).
// ───────────────────────────────────────────────

model PEDDCase {
  id        String         @id @default(cuid())
  /// MADeal 1개당 canonical DD case 1개만 허용(버저닝 없음)
  maDealId  String         @unique
  status    PEDDCaseStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  maDeal           MADeal              @relation(fields: [maDealId], references: [id], onDelete: Cascade)
  findings         PEDDFinding[]
  evidence         PEEvidence[]
  evidenceRequests PEEvidenceRequest[]

  @@index([maDealId])
}

model PEDDFinding {
  id       String @id @default(cuid())
  ddCaseId String

  category    PEDDCategory
  /// 자유 텍스트 — dd-types.ts PEDDSubCategory와 동일하게 고정 enum으로 만들지 않는다
  subCategory String?
  title       String
  description String            @db.Text
  severity    PEDDSeverity
  status      PEDDFindingStatus @default(DRAFT)

  /// MAFinancialPeriod.id — 딜 무관 finding(예: 순수 LEGAL 이슈)은 비워둘 수 있다.
  /// 반드시 ddCase와 같은 MADeal에 속한 기간이어야 한다(FK만으로는 보장되지
  /// 않아 pe-dd-repository.ts가 쓰기 시점에 별도 검증한다).
  financialPeriodId String?
  /// 자유 텍스트(담당자명/팀명) — User FK로 강제하지 않는다(dd-types.ts owner?: string과 동일 계약)
  owner       String?
  resolution  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ddCase          PEDDCase           @relation(fields: [ddCaseId], references: [id], onDelete: Cascade)
  financialPeriod MAFinancialPeriod? @relation(fields: [financialPeriodId], references: [id], onDelete: SetNull)
  evidence        PEEvidence[]

  @@index([ddCaseId])
  @@index([financialPeriodId])
  @@index([status])
}

/// Source(문서/출처)와 Evidence(그 안의 구체적 근거)를 한 행에 담는다(§0 주석 참고).
/// PEDDFinding.evidenceIds가 요구하는 "근거 1건"의 단위가 바로 이 행이다.
model PEEvidence {
  id       String  @id @default(cuid())
  ddCaseId String
  /// 특정 finding에 연결하지 않고 DD case 레벨 근거로만 둘 수도 있다(optional)
  findingId String?
  /// 업로드 문서에서 온 근거일 때만 — DART/수기입력 등은 비워둔다
  documentId String?

  sourceType        MaFinancialSourceType
  sourceName        String
  /// 알 때만 채운다 — 추정 금지(evidence-lineage-types.ts PEEvidenceSource와 동일 계약)
  sourceLocation     String?
  externalReference  String?
  /// Source보다 더 구체적인 위치(예: "23페이지 표3")
  locator            String?
  excerpt            String? @db.Text
  /// 0~1 범위(evidence-lineage.ts createEvidenceItem()과 동일 규칙, 쓰기 시점에 검증)
  confidence         Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ddCase   PEDDCase     @relation(fields: [ddCaseId], references: [id], onDelete: Cascade)
  finding  PEDDFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  document MADocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([ddCaseId])
  @@index([findingId])
  @@index([documentId])
}

/// IC 검토 워크플로 메타데이터(PR #109). "review item"(블로커/누락 정보/DD
/// finding에서 파생된 항목) 자체는 이 테이블에 저장하지 않는다 — 그건 항상
/// buildPEDecisionReadiness()/buildPEICReviewItems()가 매번 다시 계산하는
/// 파생값이다(§핵심 원칙 5: "Do not persist derived readiness state"). 이
/// 테이블이 저장하는 건 오직 사람이 실제로 한 행동, 즉 "이 근거를
/// 요청했다"는 워크플로 사실뿐이다("Persist only workflow metadata"). 어떤
/// review item에 대한 요청인지는 그 review item의 결정론적 코드
/// (pe-ic-review.ts가 만드는 것과 동일한 포맷 — 예: "BLOCKER:xxx",
/// "DD_FINDING:xxx")로만 연결한다(reviewItemSourceType/reviewItemSourceId).
model PEEvidenceRequest {
  id       String @id @default(cuid())
  ddCaseId String

  /// review item의 결정론적 소스 식별자 — review item을 여기 FK로 잡지 않는
  /// 이유: review item 자체가 파생값이라 안정적인 PK가 없다(§Step3 주석 참고).
  reviewItemSourceType String
  reviewItemSourceId   String

  title             String
  requestedDocument String?
  requestedFact     String?
  reason            String                  @db.Text
  priority          PEICQuestionPriorityDb
  status            PEEvidenceRequestStatus @default(REQUESTED)

  /// 실제 연결된 Data Room 문서(있으면). 문서가 삭제돼도 요청 자체는 감사
  /// 기록으로 남아야 하므로 SetNull(PEEvidence.documentId와 동일 계약).
  linkedDocumentId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ddCase         PEDDCase    @relation(fields: [ddCaseId], references: [id], onDelete: Cascade)
  linkedDocument MADocument? @relation(fields: [linkedDocumentId], references: [id], onDelete: SetNull)

  @@index([ddCaseId])
  @@index([reviewItemSourceType, reviewItemSourceId])
  @@index([linkedDocumentId])
}

enum PEEvidenceRequestStatus {
  REQUESTED
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

/// src/lib/pe/pe-ic-decision-types.ts PE_IC_QUESTION_PRIORITIES(PR #108)와
/// 값이 정확히 일치해야 한다. Prisma enum 이름이 "Priority"와 충돌하지
/// 않도록 접미사 Db를 붙였다(다른 도메인의 Priority enum과 혼동 방지).
enum PEICQuestionPriorityDb {
  P0
  P1
  P2
}

/// PE IC Committee Pack — Review Sign-off(PR #110). "검토했다"는 사실만
/// 기록한다 — 절대 투자 승인/추천을 뜻하지 않는다(pe-ic-review-signoff-types.ts
/// 상단 주석 참고). REVIEWED는 여기 저장하되, 저장 당시의 canonical
/// fingerprint와 지금 fingerprint가 다르면 UI/API는 이 값을 그대로 쓰지 않고
/// RE_REVIEW_REQUIRED로 파생 표시한다(§Step13 — 값 자체는 덮어쓰지 않음,
/// 새로 재검토해야만 갱신).
model PEICReview {
  id       String @id @default(cuid())
  maDealId String

  reviewerId String
  status     PEICReviewSignoffStatus @default(NOT_REVIEWED)

  /// 현재 상태에 대한 리뷰어의 메모. CHANGES_REQUESTED로 전환할 때는
  /// repository가 이 필드를 필수로 요구한다(§Step11).
  comment String? @db.Text

  /// REVIEWED로 전환한 시점에 계산한 buildPECommitteePack().fingerprint를
  /// 그대로 저장한다 — 재무/QoE/LBO/DD/근거요청 등 canonical 데이터가 아니다,
  /// 그 데이터들의 해시일 뿐이다.
  reviewedFingerprint String?
  /// computeCommitteePackFingerprintBreakdown()의 JSON 직렬화 — §Step14
  /// "무엇이 바뀌었는가"를 새 히스토리 테이블 없이 보여주기 위한 것.
  /// 리뷰 이력 전체가 아니라 "마지막 검토 시점의 스냅샷 1개"만 저장한다.
  reviewedFingerprintBreakdown String? @db.Text
  reviewedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maDeal   MADeal @relation(fields: [maDealId], references: [id], onDelete: Cascade)
  reviewer User   @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  comments PEICReviewComment[]

  @@unique([maDealId, reviewerId])
  @@index([maDealId])
}

enum PEICReviewSignoffStatus {
  NOT_REVIEWED
  IN_REVIEW
  CHANGES_REQUESTED
  REVIEWED
}

/// 리뷰어가 특정 대상(Committee Pack 전체/IC Question/Review Item/Evidence
/// Request)에 남기는 메모(§Step10). 의견/메모일 뿐 canonical 재무 데이터를
/// 절대 바꾸지 않는다 — targetType/targetId는 PEEvidenceRequest의
/// reviewItemSourceType/reviewItemSourceId와 동일하게 결정론적 문자열
/// 키만 쓴다(review item을 FK로 잡지 않는 이유도 동일, §Step3 주석 참고).
model PEICReviewComment {
  id       String @id @default(cuid())
  maDealId String
  reviewId String?

  authorId   String
  targetType PEICReviewCommentTargetType
  /// COMMITTEE_PACK 전체에 대한 메모면 null.
  targetId   String?

  text      String   @db.Text
  createdAt DateTime @default(now())

  maDeal MADeal      @relation(fields: [maDealId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  review PEICReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)

  @@index([maDealId])
  @@index([targetType, targetId])
  @@index([reviewId])
}

enum PEICReviewCommentTargetType {
  COMMITTEE_PACK
  IC_QUESTION
  REVIEW_ITEM
  EVIDENCE_REQUEST
}

/// PE IC Review Audit Trail(PR #111) — 검토 완료(REVIEWED) 시점의 불변
/// 스냅샷. `PEICReview`(PR #110)는 "리뷰어 한 명당 지금 상태"를 나타내는
/// 살아있는 행이라 재검토할 때마다 upsert로 덮어써진다 — 그래서 "Review #1을
/// 무엇을 근거로 승인했는지"를 나중에 재구성할 수 없었다. 이 모델은 그
/// 문제를 푼다: REVIEWED로 전환하는 순간마다(재검토 포함) 새 행을 1개
/// insert하고, 그 이후로는 애플리케이션 코드에서 절대 UPDATE/DELETE하지
/// 않는다(§6 불변성). `version`은 딜 하나당 단조 증가하는 정수이고,
/// 트랜잭션 안에서 서버가 계산한다 — 클라이언트가 절대 보내지 않는다.
model PEICReviewSnapshot {
  id       String @id @default(cuid())
  maDealId String
  /// 딜 하나 안에서 단조 증가(리뷰어와 무관 — "이 딜의 몇 번째 검토 완료인가").
  version  Int

  reviewerId String

  /// buildPECommitteePack().fingerprint를 그대로 저장한다(재계산이 아니라 복사).
  fingerprint String
  /// computeCommitteePackFingerprintBreakdown()의 JSON 직렬화 — 카테고리별 하위 해시.
  fingerprintBreakdown String @db.Text

  /// 이 시점에 재계산한 buildICQuestions() 결과에서 뽑은 미해결 항목
  /// 코드 배열(JSON) — 전체 질문 본문이 아니라 결정론적 코드만 저장한다
  /// (§45 프라이버시 — 원본 문서/민감정보 대신 참조만).
  openQuestionCodes String @db.Text
  openQuestionCount Int
  /// P0 우선순위(즉시 확인 필요) 미해결 항목 수만 별도로 기록 — 위원회가
  /// "핵심 blocker가 몇 건 남은 채로 검토됐는가"를 바로 볼 수 있게.
  openP0Count       Int

  /// 검토 당시 리뷰어가 남긴 메모(있으면) — PEICReview.comment를 그 순간에 복사.
  comment    String?  @db.Text
  reviewedAt DateTime

  createdAt DateTime @default(now())

  maDeal   MADeal @relation(fields: [maDealId], references: [id], onDelete: Cascade)
  reviewer User   @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  auditEvents PEICAuditEvent[]

  @@unique([maDealId, version])
  @@index([maDealId, createdAt])
}

/// PE IC Review Audit Trail(PR #111) — append-only 이벤트 로그. 일반
/// 사용자 액션으로는 절대 UPDATE/DELETE하지 않는다(§13). actorId는 항상
/// 인증된 세션의 userId에서만 채운다 — 클라이언트가 보낸 값을 쓰지
/// 않는다(§14 "actor 스푸핑 불가").
model PEICAuditEvent {
  id       String @id @default(cuid())
  maDealId String
  /// REVIEW_COMPLETED 이벤트만 채운다(그 순간 만들어진 스냅샷을 가리킴).
  reviewSnapshotId String?

  actorId   String
  eventType PEICAuditEventType

  /// 코멘트 대상과 같은 관례(PEICReviewComment.targetType/targetId) — review
  /// item/evidence request 코드 같은 결정론적 참조 문자열만 담는다.
  targetType String?
  targetId   String?

  /// 원본 문서/민감정보를 담지 않는다 — 구조적 참조/카운트만(§45).
  metadata Json?

  createdAt DateTime @default(now())

  maDeal         MADeal              @relation(fields: [maDealId], references: [id], onDelete: Cascade)
  actor          User                @relation(fields: [actorId], references: [id], onDelete: Cascade)
  reviewSnapshot PEICReviewSnapshot? @relation(fields: [reviewSnapshotId], references: [id], onDelete: SetNull)

  @@index([maDealId, createdAt])
  @@index([actorId, createdAt])
  @@index([reviewSnapshotId])
}

enum PEICAuditEventType {
  REVIEW_STARTED
  CHANGE_REQUESTED
  REVIEW_COMPLETED
  COMMENT_ADDED
  EVIDENCE_REQUESTED
}

enum PEDDCaseStatus {
  ACTIVE
  ARCHIVED
}

/// src/lib/pe/dd-types.ts PE_DD_CATEGORIES와 값이 정확히 일치해야 한다.
enum PEDDCategory {
  FINANCIAL
  COMMERCIAL
  OPERATIONAL
  LEGAL
  TAX
  HR
  TECHNOLOGY
  IT_SECURITY
  REGULATORY
  ESG
  MANAGEMENT
  OTHER
}

/// src/lib/pe/dd-types.ts PE_DD_SEVERITIES와 값이 정확히 일치해야 한다.
enum PEDDSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// src/lib/pe/dd-types.ts PE_DD_FINDING_STATUSES와 값이 정확히 일치해야 한다.
/// CONFIRMED/MITIGATED/ACCEPTED/CLOSED는 evidence가 최소 1건 있어야만
/// pe-dd-repository.ts가 쓰기를 허용한다(requiresEvidenceForStatus() 재사용).
enum PEDDFindingStatus {
  DRAFT
  IN_REVIEW
  CONFIRMED
  MITIGATED
  ACCEPTED
  REJECTED
  CLOSED
}
